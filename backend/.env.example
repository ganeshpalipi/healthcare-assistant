# Healthcare Conversational Assistant - Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas
MONGODB_URL=
MONGODB_DATABASE=healthcare_assistant

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-long-random-string

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS
FRONTEND_ORIGINS=http://localhost:5173

# RAG Configuration
RAG_INDEX_PATH=../vector_database/medical.faiss
RAG_METADATA_PATH=../vector_database/medical_chunks.json
RAG_TOP_K=3

# NLP Configuration
NLP_MODEL=d4data/biomedical-ner-all
NLP_FALLBACK_ENABLED=true
